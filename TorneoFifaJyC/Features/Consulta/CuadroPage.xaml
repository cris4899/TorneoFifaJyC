<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:TorneoFifaJyC.Features.Consulta"
             x:Class="TorneoFifaJyC.Features.Consulta.CuadroPage"
             x:DataType="vm:CuadroPageViewModel"
             Title="Cuadro del torneo">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16" RowSpacing="12">

        <!-- Cabecera: nombre y estado del torneo -->
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="{Binding Nombre}"
                   FontSize="22" FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding EstadoTorneoTexto}"
                   FontSize="14" TextColor="Gray"
                   SemanticProperties.Description="Estado del torneo" />
        </VerticalStackLayout>

        <!-- Selector de ronda -->
        <Picker Grid.Row="1"
                Title="Elige una ronda"
                ItemsSource="{Binding Rondas}"
                ItemDisplayBinding="{Binding Nombre}"
                SelectedItem="{Binding RondaSeleccionada}"
                IsVisible="{Binding MostrarContenido}"
                SemanticProperties.Hint="Cambia la ronda que se muestra en el cuadro" />

        <!-- Cuadro: cruces de la ronda seleccionada -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding PartidosVisibles}"
                        IsVisible="{Binding MostrarContenido}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:PartidoFila">
                    <Border Margin="0,6" Padding="12" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                        <VerticalStackLayout Spacing="4"
                                             SemanticProperties.Description="{Binding Descripcion}">
                            <Label Text="{Binding Local}" FontAttributes="Bold" />
                            <Label Text="{Binding Visitante}" FontAttributes="Bold" />
                            <Label Text="{Binding Marcador}" FontSize="18" />
                            <Label Text="{Binding Resultado}" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Avisos de carga, vacío, error y desactualizado -->
        <VerticalStackLayout Grid.Row="2" VerticalOptions="Center" Spacing="8"
                             IsVisible="{Binding MostrarCargando}">
            <ActivityIndicator IsRunning="{Binding MostrarCargando}" />
            <Label Text="Cargando el cuadro…" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <Label Grid.Row="2" VerticalOptions="Center" HorizontalTextAlignment="Center"
               Text="{Binding MensajeEstado}"
               IsVisible="{Binding MostrarVacio}"
               SemanticProperties.Description="{Binding MensajeEstado}" />

        <!-- Pie: campeón, aviso de desactualizado y botón Reintentar -->
        <VerticalStackLayout Grid.Row="3" Spacing="8">
            <Label Text="{Binding CampeonTexto}"
                   IsVisible="{Binding HayCampeon}"
                   FontAttributes="Bold" FontSize="16"
                   SemanticProperties.HeadingLevel="Level2"
                   SemanticProperties.Description="{Binding CampeonTexto}" />
            <Label Text="{Binding MensajeEstado}"
                   IsVisible="{Binding EstaDesactualizado}"
                   TextColor="Gray" />
            <Button Text="Reintentar"
                    Command="{Binding ReintentarComando}"
                    IsVisible="{Binding MostrarReintentar}"
                    SemanticProperties.Hint="Vuelve a consultar el cuadro" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
