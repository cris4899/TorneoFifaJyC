<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controles="clr-namespace:TorneoFifaJyC.Controls"
             xmlns:vm="clr-namespace:TorneoFifaJyC.Features.Consulta"
             x:Class="TorneoFifaJyC.Features.Consulta.CuadroPage"
             x:DataType="vm:CuadroPageViewModel"
             Title="Cuadro del torneo"
             BackgroundColor="{StaticResource Fondo}">

    <!-- Fila 0: aviso de conexión y Reintentar, fijos arriba y visibles sin desplazarse (#37). -->
    <Grid RowDefinitions="Auto,*">

        <Border Grid.Row="0" IsVisible="{Binding MostrarReintentar}"
                BackgroundColor="{StaticResource Superficie}" Stroke="{StaticResource Borde}" StrokeThickness="1"
                Padding="12" Margin="16,12,16,0" StrokeShape="RoundRectangle 10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0" VerticalOptions="Center" TextColor="{StaticResource Claro}"
                       Text="{Binding MensajeEstado}" SemanticProperties.Description="{Binding MensajeEstado}" />
                <Button Grid.Column="1" Text="Reintentar" Command="{Binding ReintentarComando}"
                        BackgroundColor="{StaticResource Verde}" TextColor="{StaticResource Fondo}"
                        SemanticProperties.Hint="Vuelve a consultar el cuadro" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
        <ScrollView>
            <VerticalStackLayout Padding="16,16,16,96" Spacing="12">

                <!-- Ajustes del servicio: solo se ven desde «Ajustes» del menú flotante -->
                <Border x:Name="AjustesPanel" IsVisible="False" Style="{StaticResource Tarjeta}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Servicio de consulta" FontAttributes="Bold" FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource Claro}" SemanticProperties.HeadingLevel="Level2" />
                        <Entry x:Name="DireccionEntry" Placeholder="http://192.168.1.50:5080"
                               Keyboard="Url" TextColor="{StaticResource Claro}" PlaceholderColor="{StaticResource Atenuado}"
                               SemanticProperties.Description="Dirección del servicio de consulta" />
                        <HorizontalStackLayout Spacing="8">
                            <Button Text="Probar conexión" Clicked="OnProbarConexion"
                                    BackgroundColor="{StaticResource Superficie}" TextColor="{StaticResource Claro}"
                                    BorderColor="{StaticResource Verde}" BorderWidth="1"
                                    SemanticProperties.Hint="Comprueba que el servicio responde" />
                            <Button Text="Guardar" Clicked="OnGuardarDireccion"
                                    BackgroundColor="{StaticResource Verde}" TextColor="{StaticResource Fondo}"
                                    SemanticProperties.Hint="Guarda la dirección y recarga" />
                        </HorizontalStackLayout>
                        <Label x:Name="EstadoConexionLabel" TextColor="{StaticResource Claro}" />
                        <Label Text="{Binding ModoDemoTexto}" IsVisible="{Binding ModoDemo}"
                               TextColor="{StaticResource Verde}" FontAttributes="Bold"
                               SemanticProperties.Description="{Binding ModoDemoTexto}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout x:Name="ContenidoPanel" Spacing="12">
                <!-- Selección de torneo -->
                <Picker x:Name="TorneoPicker" Title="Elige un torneo"
                        ItemsSource="{Binding TorneosDisponibles}" ItemDisplayBinding="{Binding Nombre}"
                        SelectedItem="{Binding TorneoSeleccionado, Mode=OneWay}"
                        SelectedIndexChanged="OnTorneoCambiado"
                        IsVisible="{Binding HayTorneos}"
                        TextColor="{StaticResource Claro}" TitleColor="{StaticResource Fondo}"
                        BackgroundColor="{StaticResource Superficie}"
                        SemanticProperties.Hint="Elige el torneo que quieres consultar" />

                <!-- Campeón: tarjeta dorada -->
                <Border IsVisible="{Binding HayCampeon}" BackgroundColor="{StaticResource Oro}"
                        Stroke="{StaticResource Oro}" Padding="14" StrokeShape="RoundRectangle 10"
                        SemanticProperties.Description="{Binding CampeonTexto}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="🏆 CAMPEÓN" FontFamily="OpenSansSemibold" CharacterSpacing="2"
                               TextColor="{StaticResource Fondo}" />
                        <Label Text="{Binding CampeonTexto}" FontSize="20" FontFamily="OpenSansSemibold"
                               TextColor="{StaticResource Fondo}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Cabecera y última actualización -->
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Nombre}" FontSize="22" FontAttributes="Bold" FontFamily="OpenSansSemibold"
                           TextColor="{StaticResource Claro}" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding EstadoTorneoTexto}" FontSize="14" TextColor="{StaticResource Atenuado}"
                           SemanticProperties.Description="Estado del torneo" />
                    <Label Text="{Binding UltimaActualizacionTexto}" FontSize="12" TextColor="{StaticResource Atenuado}"
                           SemanticProperties.Description="{Binding UltimaActualizacionTexto}" />
                </VerticalStackLayout>

                <!-- Vista Rondas -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding MostrarRondas}">
                    <CollectionView ItemsSource="{Binding Rondas}" SelectionMode="Single" SelectedItem="{Binding RondaSeleccionada}"
                                    HeightRequest="56" BackgroundColor="Transparent"
                                    SemanticProperties.Hint="Cambia la ronda que se muestra">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="{x:Null}">
                                <Border Padding="18,0" HeightRequest="48" MinimumWidthRequest="48" StrokeShape="RoundRectangle 24"
                                        BackgroundColor="{StaticResource Superficie}" Stroke="{StaticResource Borde}" StrokeThickness="1">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroupList>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource Superficie}" />
                                                        <Setter Property="Stroke" Value="{StaticResource Borde}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Selected">
                                                    <VisualState.Setters>
                                                        <Setter Property="BackgroundColor" Value="{StaticResource VerdeOscuro}" />
                                                        <Setter Property="Stroke" Value="{StaticResource Verde}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateGroupList>
                                    </VisualStateManager.VisualStateGroups>
                                    <Label Text="{Binding Nombre}" TextColor="White" VerticalOptions="Center"
                                           FontFamily="OpenSansSemibold" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <CollectionView ItemsSource="{Binding PartidosVisibles}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PartidoFila">
                                <Border Margin="0,6" Padding="14" StrokeThickness="1" Stroke="{StaticResource Borde}"
                                        BackgroundColor="{StaticResource Superficie}" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="4" SemanticProperties.Description="{Binding Descripcion}">
                                        <Label Text="{Binding Ronda}" FontSize="11" CharacterSpacing="1"
                                               TextColor="{StaticResource Atenuado}" />
                                        <Label Text="{Binding Local}" FontAttributes="Bold" TextColor="{StaticResource Claro}" />
                                        <Label Text="{Binding Visitante}" FontAttributes="Bold" TextColor="{StaticResource Claro}" />
                                        <Label Text="{Binding Marcador}" FontSize="20" FontFamily="OpenSansSemibold"
                                               TextColor="{StaticResource Verde}" />
                                        <Label Text="{Binding Resultado}" TextColor="{StaticResource Atenuado}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Vista Próximos -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding MostrarProximos}">
                    <Label Text="No hay próximos cruces disponibles." IsVisible="{Binding SinProximos}"
                           TextColor="{StaticResource Atenuado}" />
                    <CollectionView ItemsSource="{Binding ProximosFilas}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PartidoFila">
                                <Border Margin="0,6" Padding="14" StrokeThickness="1" Stroke="{StaticResource Borde}"
                                        BackgroundColor="{StaticResource Superficie}" StrokeShape="RoundRectangle 10">
                                    <VerticalStackLayout Spacing="4" SemanticProperties.Description="{Binding Descripcion}">
                                        <Label Text="{Binding Ronda}" FontSize="11" CharacterSpacing="1"
                                               TextColor="{StaticResource Verde}" />
                                        <Label Text="{Binding Local}" FontAttributes="Bold" TextColor="{StaticResource Claro}" />
                                        <Label Text="{Binding Visitante}" FontAttributes="Bold" TextColor="{StaticResource Claro}" />
                                        <Label Text="PENDIENTE" FontSize="11" CharacterSpacing="1" TextColor="{StaticResource Oro}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Avisos de carga y vacío -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding MostrarCargando}">
                    <ActivityIndicator IsRunning="{Binding MostrarCargando}" Color="{StaticResource Verde}" />
                    <Label Text="Cargando el cuadro…" TextColor="{StaticResource Claro}" HorizontalOptions="Center" />
                </VerticalStackLayout>
                <Label Text="{Binding MensajeEstado}" IsVisible="{Binding MostrarVacio}"
                       TextColor="{StaticResource Claro}" HorizontalTextAlignment="Center"
                       SemanticProperties.Description="{Binding MensajeEstado}" />

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <controles:MenuFlotante x:Name="Menu" />
        </Grid>
    </Grid>

</ContentPage>
